# URL de l'application THRIVE (espace membre).
# Le bouton "Connexion" du site pointe vers `${VITE_APP_URL}/login`.
# En local (app lancée via pnpm dev dans "thrive APP"), laisser la valeur par défaut.
# En production (Vercel → Settings → Environment Variables), définir l'URL publique
# de l'app, ex. https://app.thrivesportpositive.com
VITE_APP_URL=http://localhost:3001
