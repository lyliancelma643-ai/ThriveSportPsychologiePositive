# URL de l'application THRIVE (espace membre).
# Le bouton "Connexion" du site pointe vers `${VITE_APP_URL}/login`.
# Optionnelle : sans cette variable, le site utilise http://localhost:3001 en dev
# et https://thrive-app-inky.vercel.app en production (voir Navbar.jsx).
# À définir dans Vercel (Settings → Environment Variables) uniquement si l'app
# change de domaine, ex. https://app.thrivesportpositive.com
VITE_APP_URL=http://localhost:3001
