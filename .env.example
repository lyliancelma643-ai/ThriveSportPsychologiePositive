# URL de l'application THRIVE (espace membre).
# Le bouton "Connexion" du site pointe vers `${VITE_APP_URL}/login`.
# Optionnelle : sans cette variable, le site utilise http://localhost:3001 en dev
# et https://app.thrivesportpositive.com en production (voir Navbar.jsx).
# À définir dans Vercel (Settings → Environment Variables) uniquement si l'app
# change encore de domaine.
VITE_APP_URL=http://localhost:3001

# Supabase — utilisé UNIQUEMENT par la page /liste-attente, pour déposer une
# inscription dans la table `waitlist` (projet THRIVE-CA, ca-central-1).
# Optionnelles : sans elles, le site utilise le projet de production (voir
# src/lib/supabase.js). À définir dans Vercel seulement pour pointer ailleurs.
#
# La clé anon est PUBLIQUE par conception : c'est la RLS qui protège les
# données (INSERT ouvert, lecture réservée au super admin). Ne JAMAIS mettre la
# clé service_role ici — elle contournerait toute la RLS et serait servie au
# navigateur de chaque visiteur.
VITE_SUPABASE_URL=https://kkdcgzvdmipmrgkawnky.supabase.co
VITE_SUPABASE_ANON_KEY=
